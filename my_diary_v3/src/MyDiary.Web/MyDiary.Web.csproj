<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Suppress inherited warnings from migrated Project A/B code (nullable, MudBlazor
         analyzer, unused/obsolete). These were pre-existing in the source projects;
         not hand-fixing 1000+ across migrated files. Remove a code to surface it again. -->
    <NoWarn>$(NoWarn);CS8618;CS8601;CS8602;CS8603;CS8604;CS8600;CS8625;CS8620;CS8619;CS8669;CS8714;CS8622;MUD0002;CS0414;CS0649;CS0219;CS0168;CS0169;CS0618;CS0105;CS4014;CS8321;RZ10012</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyDiary.Core\MyDiary.Core.csproj" />
    <ProjectReference Include="..\MyDiary.Data\MyDiary.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazor-ApexCharts" Version="6.1.0" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="EPPlus" Version="8.6.1" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.23" />
    <PackageReference Include="Hangfire.MemoryStorage" Version="1.8.1.2" />
    <PackageReference Include="Hangfire.Oracle.Core" Version="1.3.24" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.72" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.10" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.6" />
    <PackageReference Include="MudBlazor" Version="8.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="8.23.26000" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.200" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="QuestPDF" Version="2026.6.1" />
    <PackageReference Include="System.Data.Odbc" Version="10.0.3" />
    <PackageReference Include="Scriban.Signed" Version="7.2.5" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.2" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SSH.NET" Version="2024.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MyDiary.Web</RootNamespace>
  </PropertyGroup>

  <!-- Include App_Data folder in publish output -->
	<ItemGroup>
		<Content Include="App_Data\**" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="wwwroot\MyDiary\download\" />
	  <Folder Include="wwwroot\MyDiary\UBINET\" />
	</ItemGroup>

</Project>
