@page "/reports/deployment-pulse-itsm"
@attribute [AllowAnonymous]
@layout MyDiary.Web.Components.Layout.LandingLayout
@using Microsoft.AspNetCore.Authorization
@using MyDiary.Web.Features.DeploymentPulse.Models
@using MyDiary.Web.Features.DeploymentPulse.Services
@inject IDeploymentPulseService DeploymentPulseService

<PageTitle>Deployment Pulse ITSM</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h5" Class="mb-4">Deployment Pulse ITSM</MudText>

    @* ---- Filters ---- *@
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" sm="6" md="2">
                <MudTextField @bind-Value="_filter.CrqNumber" Label="CR No." Immediate="false" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudTextField @bind-Value="_filter.Vertical" Label="Vertical" Immediate="false" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect @bind-Value="_filter.Status" Label="Status">
                    <MudSelectItem Value="@("ALL")">All</MudSelectItem>
                    <MudSelectItem Value="@("Planned")">Planned</MudSelectItem>
                    <MudSelectItem Value="@("Live")">Live</MudSelectItem>
                    <MudSelectItem Value="@("Rolled back")">Rolled back</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect @bind-Value="_filter.PublishYear" Label="Publish Year">
                    <MudSelectItem Value="@("ALL")">All</MudSelectItem>
                    @foreach (var year in _publishYears)
                    {
                        <MudSelectItem Value="@year">@year</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudDatePicker @bind-Date="_filter.FromDate" Label="From (Tentative)" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudDatePicker @bind-Date="_filter.ToDate" Label="To (Tentative)" />
            </MudItem>
        </MudGrid>
        <MudStack Row="true" Class="mt-3" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text" OnClick="ResetFilters">Reset</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Search">Search</MudButton>
        </MudStack>
    </MudPaper>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" />
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mb-2">@_items.Count record(s) found</MudText>
    }

    @* ---- Grid ---- *@
    <MudTable Items="_items" Hover="true" Dense="true" Loading="_loading" RowsPerPage="20">
        <HeaderContent>
            <MudTh>CR No.</MudTh>
            <MudTh>Vertical</MudTh>
            <MudTh>Impact</MudTh>
            <MudTh>Tentative Go-Live</MudTh>
            <MudTh>Actual Go-Live</MudTh>
            <MudTh>Status</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="CR No.">@context.CrqNumber</MudTd>
            <MudTd DataLabel="Vertical">@context.Vertical</MudTd>
            <MudTd DataLabel="Impact">@context.Impact</MudTd>
            <MudTd DataLabel="Tentative Go-Live">@FormatDate(context.TentativeGoLiveDate)</MudTd>
            <MudTd DataLabel="Actual Go-Live">@FormatDate(context.ActualGoLiveDate)</MudTd>
            <MudTd DataLabel="Status">@context.Status</MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ShowDetails(context))">View</MudButton>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>

    @* ---- Detail panel ---- *@
    @if (_selected is not null)
    {
        <MudPaper Class="pa-4 mt-4" Elevation="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h6">@_selected.CrqNumber</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => _selected = null)" />
            </MudStack>
            <MudGrid Class="mt-2">
                <MudItem xs="12" md="6"><b>Vertical:</b> @_selected.Vertical</MudItem>
                <MudItem xs="12" md="6"><b>Impact:</b> @_selected.Impact</MudItem>
                <MudItem xs="12"><b>Description:</b> @_selected.Description</MudItem>
                <MudItem xs="12" md="6"><b>Tentative Go-Live:</b> @FormatDate(_selected.TentativeGoLiveDate)</MudItem>
                <MudItem xs="12" md="6"><b>Actual Go-Live:</b> @FormatDate(_selected.ActualGoLiveDate)</MudItem>
                @* SPOC_DETAILS carries a name + email address - confirm this should be
                   shown on a page with no login before enabling on the public route. *@
                @* <MudItem xs="12"><b>SPOC:</b> @_selected.SpocDetails</MudItem> *@
                <MudItem xs="12" md="6"><b>Status:</b> @_selected.Status</MudItem>
            </MudGrid>
        </MudPaper>
    }
</MudContainer>

@code {
    private DeploymentPulseFilter _filter = new();
    private List<DeploymentPulseItem> _items = new();
    private List<string> _publishYears = new();
    private DeploymentPulseItem? _selected;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        _publishYears = await DeploymentPulseService.GetPublishYearsAsync();
        await LoadData();
    }

    private async Task Search() => await LoadData();

    private async Task ResetFilters()
    {
        _filter = new DeploymentPulseFilter();
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _selected = null;
        try
        {
            // onlyPublished defaults to true - this route is anonymous, so it should
            // only ever surface rows marked PUBLISH_FLAG = 'Y'.
            _items = await DeploymentPulseService.GetDeploymentsAsync(_filter);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ShowDetails(DeploymentPulseItem item) => _selected = item;

    private static string FormatDate(DateTime? date) => date?.ToString("dd-MMM-yyyy") ?? string.Empty;
}
